# =========================================================
#  Taller 03 v2 — Solver multiagente · MMIA 6013
#  Base: .gitignore del Taller 02, adaptado (ver notas ⚠)
# =========================================================

# ---------- Secretos (hallazgo bloqueante si se suben) ----------
.env
.env.*
!.env.example
*.key
*.pem
secrets/
credentials*.json

# ---------- Entorno virtual / uv ----------
.venv/
venv/
env/
.uv-cache/

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------- Jupyter ----------
.ipynb_checkpoints/
.virtual_documents/

# ---------- Artefactos regenerables del solver ----------
# Grafo y embeddings de las notas del curso (~6 min de indexado): se cachean, no se versionan
cache/
# Carpetas de trabajo temporales del sandbox
sandbox_tmp/
# Cachés del sandbox dentro de cada corrida (fuentes de matplotlib…): no son resultados
**/cache_solver/tmp/
# ⚠ A diferencia del Taller 02, NO se ignoran:
#   *.jsonl  -> corridas/tarea-*/traza.jsonl es entregable
#   data/    -> tareas/reales/semana*/data/*.csv son entradas del golden set
#   corridas/ (plan.json, entregables) también es entregable.
# Revisen las trazas antes de subirlas: guardan los mensajes enteros.

# ---------- Cachés de modelos (Hugging Face / sentence-transformers / torch) ----------
.cache/
hf_cache/
models_cache/

# ---------- Comprimidos ----------
*.zip
*.tar.gz

# ---------- Sistema operativo / editores ----------
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# ---------- Taller 04 ----------
# Los ensayos (scripts/corridas_t4.sh prueba) no se entregan: el del 2026-10-15 se hizo antes de
# la regla de nombres y su traza tiene el nombre sintético de la Tarea P. Se entregan base y mejora.
corridas/t4/prueba/
resultados/t4/*prueba*
taller04/parte1/*prueba*

# Bloqueos de LibreOffice al exportar el informe
.~lock.*#
informe/*.tmp
