# Copia a .env (que .gitignore excluye). Ninguna clave va al repositorio.
# El sandbox NO hereda estas variables: los scripts generados corren con entorno vacio.

# ---------- H200 de la USFQ (GlobalProtect conectada) ----------
# Mismos nombres que lee solver-v2/h200.py. vLLM no pide clave real.
H200_HOST=172.28.230.10
H200_PUERTO=12555
# Replica del vLLM (extension A, subtareas en paralelo)
H200_PUERTO_REPLICA=12559
# Embeddings bge-m3 en el Ollama (el /v1/embeddings del 12555 responde 404)
H200_PUERTO_EMB=11434
H200_MODELO_EMB=bge-m3:latest
# El id del LLM NO se escribe: se lee de /v1/models (el vLLM sirve uno solo).
# Si el vLLM está caído, para DESARROLLAR se puede usar el Ollama del 11434, que sirve varios:
#   H200_PUERTO=11434
#   H200_MODELO=qwen3:32b      (se comprueba contra /v1/models; gemma3 queda para el juez de la ext. E)
# Las corridas medidas de las Partes 1-2 usan UN solo modelo: el de la 0.a.
H200_MODELO=
# Tiempo máximo de UNA llamada al LLM (h200.py usa 600 s; con el Ollama compartido no alcanza)
H200_TIMEOUT_S=900

# ---------- Frenos (Parte 3) ----------
SOLVER_PRESUPUESTO_TOKENS=500000
SOLVER_RESERVA_REDACTOR=50000
SOLVER_MAX_INTENTOS=3
SANDBOX_TIMEOUT_S=120

# =====================================================================================
# ---------- Taller 04 (LLMOps) ----------
# Un solo .env para el solver y para las herramientas del kit (taller-04-llmops/):
# load_dotenv() busca desde la carpeta del script hacia arriba y llega a este archivo.
# No crear otro .env dentro de taller-04-llmops/: taparía a este.

# --- Langfuse autoalojado (Docker de clase, servidor 4.53.0 el 2026-10-15)
# Proyecto «taller-04-alvarez» → Settings → API Keys. NUNCA se versiona.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000

# --- El agente, para las herramientas del kit que usan el cliente de OpenAI
# (hola_langfuse.py, evaluar_llmops.py). El solver usa H200_* de arriba: es el mismo vLLM.
OPENAI_BASE_URL=http://172.28.230.10:12555/v1
OPENAI_API_KEY=local
AGENT_MODEL=
#   el id NO se escribe de memoria: se lee de http://172.28.230.10:12555/v1/models

# --- El juez: otro servidor y OTRA familia que el agente (Ollama de la H200)
JUEZ_BASE_URL=http://172.28.230.10:11434/v1
JUEZ_API_KEY=ollama
JUEZ_MODEL=
#   se lee de http://172.28.230.10:11434/v1/models (gemma3 en el Taller 03)

# --- Costo: la H200 cuesta cero; resumir_trazas.py --precio <fila> calcula el de referencia
PRECIO_FILA=local

# --- Lo que lee el andamiaje del kit tal como se repartió (Parte 0)
EVAL_JUDGE_MODEL=
USE_LANGFUSE=false
